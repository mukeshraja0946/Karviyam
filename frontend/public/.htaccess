<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. REDIRECT LEGACY MAINTENANCE.PHP URL TO REACT ROUTE /maintenance
  RewriteCond %{REQUEST_URI} ^/maintenance\.php$ [NC]
  RewriteRule ^(.*)$ /maintenance [R=301,L]

  # 2. ALLOW PHYSICAL FILES AND DIRECTORIES TO PASS THROUGH DIRECTLY
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. PRODUCTION SPA FALLBACK FOR REACT ROUTES (/maintenance, /shop, /product/*, /admin/*, /wishlist, /cart)
  RewriteRule ^ index.html [L]
</IfModule>
