DirectoryIndex server.js index.html index.php

<IfModule mod_passenger.c>
  PassengerEnabled On
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. REDIRECT LEGACY MAINTENANCE.PHP URL TO REACT ROUTE /maintenance
  RewriteCond %{REQUEST_URI} ^/maintenance\.php$ [NC]
  RewriteRule ^(.*)$ /maintenance [R=301,L]

  # 2. IGNORE DEFAULT HOSTINGER WELCOME FILES AND FORWARD TO SERVER.JS
  RewriteCond %{REQUEST_URI} ^/(default\.php|default\.html|index\.php)?$ [NC]
  RewriteRule ^ server.js [QSA,L]

  # 3. ALLOW STATIC ASSET DIRECTORIES & PHYSICAL FILES TO SERVE DIRECTLY
  RewriteCond %{REQUEST_URI} ^/(uploads|assets)/ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. FORWARD ALL OTHER Dynamic REQUESTS TO PASSENGER SERVER.JS
  RewriteRule ^ server.js [QSA,L]
</IfModule>

