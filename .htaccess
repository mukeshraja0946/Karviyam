DirectoryIndex index.html /frontend/dist/index.html /dist/index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. REDIRECT LEGACY MAINTENANCE.PHP URL TO REACT ROUTE /maintenance
  RewriteCond %{REQUEST_URI} ^/maintenance\.php$ [NC]
  RewriteRule ^(.*)$ /maintenance [R=301,L]

  # 2. DO NOT REWRITE API ENDPOINTS, UPLOADS, ASSETS OR PHYSICAL FILES TO INDEX.HTML
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} ^/(api|uploads|assets)/ [NC]
  RewriteRule ^ - [L]

  # 3. PROXY /api/ REQUESTS TO LOCAL NODE.JS PROCESS IF MOD_PROXY IS ACTIVE
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # 4. PRODUCTION SPA FALLBACK FOR FRONTEND REACT ROUTES ONLY (EXCLUDING /api/)
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteRule ^ /frontend/dist/index.html [L]

  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^ /dist/index.html [L]

  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ /index.html [L]
</IfModule>
